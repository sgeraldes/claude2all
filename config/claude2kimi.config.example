# claude2kimi configuration — Kimi Code plan (https://www.kimi.com/code/docs)
# Create a key at the Kimi Code Console, then paste it below.
KIMI_API_KEY=paste-your-kimi-code-api-key-here

# Kimi Code endpoint (from the official docs — do not change).
KIMI_BASE_URL=https://api.kimi.com/coding/

# Model + context window. Quoting rules: no quotes needed here.
# Model ids come from GET /v1/models (verified live 14-sep-2026):
#   k3       ctx 1048576  (1M)    <- default
#   k3-256k  ctx  262144  (256K)
# Do not use the `k3[1m]` suffix: the API rejects it with 401 authentication_error
# ("recognized as other:k3[1m]"), which Claude Code shows as an expired session.
KIMI_MODEL=k3
KIMI_CONTEXT_WINDOW=1048576

# Tier models (Explorer+ plans serve all three).
# kimi-for-coding and -highspeed are 256K-context coding models — they cover the
# sonnet/haiku tiers (subagents, background tasks); k3 keeps the main tiers.
KIMI_SONNET_MODEL=kimi-for-coding
KIMI_HAIKU_MODEL=kimi-for-coding-highspeed
KIMI_SUBAGENT_MODEL=kimi-for-coding
