#!/usr/bin/env bash
# claude2kimi — run Claude Code against Kimi K3 (Kimi Code plan) in an isolated profile.
# Mirrors claude2kiro: all env vars and the config dir apply only to this process,
# so your regular claude / claude2kiro sessions are unaffected.
set -euo pipefail

if [[ "${CLAUDE2ALL_SEED_ONLY:-0}" == "1" ]]; then
  node "$(dirname "${BASH_SOURCE[0]}")/claude2all-profile.cjs" "${CLAUDE_CONFIG_DIR:-$HOME/.claude-profiles/kimi}" kimi
  exit
fi

CFG="$HOME/.claude2kimi/config"
if [[ ! -f "$CFG" ]]; then
  echo "claude2kimi: missing config file: $CFG" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$CFG"

if [[ -z "${KIMI_API_KEY:-}" || "$KIMI_API_KEY" == "paste-your-kimi-code-api-key-here" ]]; then
  echo "claude2kimi: set KIMI_API_KEY in $CFG first (Kimi Code Console -> Create API Key)." >&2
  exit 1
fi

BASE_URL="${KIMI_BASE_URL:-https://api.kimi.com/coding/}"
MODEL="${KIMI_MODEL:-k3}"
WINDOW="${KIMI_CONTEXT_WINDOW:-1048576}"

# Isolated profile: own settings, history, credentials — nothing leaks to ~/.claude.
export CLAUDE_CONFIG_DIR="$HOME/.claude-profiles/kimi"
node "$(dirname "${BASH_SOURCE[0]}")/claude2all-profile.cjs" "$CLAUDE_CONFIG_DIR" kimi

# Official Kimi Code env vars for Claude Code.
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_API_KEY="$KIMI_API_KEY"
unset ANTHROPIC_AUTH_TOKEN  # conflicts with ANTHROPIC_API_KEY if left over from other setups
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${KIMI_SONNET_MODEL:-$MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${KIMI_HAIKU_MODEL:-$MODEL}"
export CLAUDE_CODE_SUBAGENT_MODEL="${KIMI_SUBAGENT_MODEL:-$MODEL}"
export CLAUDE_CODE_EFFORT_LEVEL=high
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$WINDOW"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$WINDOW"

exec claude "$@"
